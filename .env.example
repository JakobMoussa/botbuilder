DATABASE_URL=postgresql://dialogue:dialogue-local-only@localhost:5432/dialogue
APP_URL=http://localhost:3000
# Docker generates persistent secrets automatically. For native development,
# set each of the following to a separate `openssl rand -hex 32` value.
AUTH_SECRET=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=dialogue-local-only
OPENAI_API_KEY=
# First account can register. Additional accounts require explicit opt-in.
ALLOW_REGISTRATION=false
FIREBASE_AUTH_ENABLED=false
FIREBASE_WEB_API_KEY=
# Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Firebase Admin Configuration (Cloud Backups & Sync)
FIREBASE_PROJECT_ID=dialogue-c8291
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=./dialogue-c8291-firebase-adminsdk-fbsvc-b4b9e086a5.json
