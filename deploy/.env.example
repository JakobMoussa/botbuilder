# Set your real HTTPS origin, without a trailing slash.
APP_URL=https://chat.deine-domain.de
# Generate a new password on the server: openssl rand -hex 32
# Use hexadecimal characters so the password also works in DATABASE_URL.
POSTGRES_PASSWORD=
PORT=3000
# Docker generates these secrets once and persists them in its secrets volume.
AUTH_SECRET=
ENCRYPTION_KEY=
OPENAI_API_KEY=
ALLOW_REGISTRATION=false
FIREBASE_AUTH_ENABLED=false
FIREBASE_WEB_API_KEY=
# Only enable if your reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
# Optional cloud backups. Configure separately on the server if needed.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
