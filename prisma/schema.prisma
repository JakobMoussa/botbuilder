generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String?
  firebaseUid  String?           @unique
  createdAt    DateTime          @default(now())
  memberships  WorkspaceMember[]
  sessions     Session[]
}

model Workspace {
  id          String                 @id @default(cuid())
  name        String
  createdAt   DateTime               @default(now())
  members     WorkspaceMember[]
  bots        Bot[]
  credentials AIProviderCredential[]
  auditLogs   AuditLog[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("OWNER")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Session {
  id          String   @id
  userId      String
  workspaceId String
  expiresAt   DateTime
  authenticatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Bot {
  id            String            @id @default(cuid())
  publicId      String            @unique @default(uuid())
  workspaceId   String
  name          String
  description   String            @default("")
  active        Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lastActivity  DateTime?
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  settings      BotSettings?
  widget        WidgetSettings?
  domains       AllowedDomain[]
  sources       KnowledgeSource[]
  chunks        KnowledgeChunk[]
  conversations Conversation[]
  usage         UsageRecord[]

  @@index([workspaceId])
}

model BotSettings {
  botId                   String                @id
  providerId              String?
  model                   String                @default("gpt-4o-mini")
  embeddingModel          String                @default("text-embedding-3-small")
  systemPrompt            String                @default("Du bist der digitale Assistent dieser Website. Beantworte Fragen anhand der bereitgestellten Wissensbasis. Erfinde keine Informationen. Sage transparent, wenn dir eine Information nicht vorliegt.")
  temperature             Float                 @default(0.3)
  maxTokens               Int                   @default(1000)
  language                String                @default("Deutsch")
  unknownAnswer           String                @default("Dazu liegen mir leider keine ausreichenden Informationen vor. Bitte kontaktiere unser Team.")
  similarityThreshold     Float                 @default(0.35)
  storeConversations      Boolean               @default(true)
  analyticsEnabled        Boolean               @default(true)
  retentionDays           Int                   @default(30)
  inputCostPerMillion     Float                 @default(0)
  outputCostPerMillion    Float                 @default(0)
  embeddingCostPerMillion Float                 @default(0)
  dailyRequestLimit       Int                   @default(1000)
  bot                     Bot                   @relation(fields: [botId], references: [id], onDelete: Cascade)
  provider                AIProviderCredential? @relation(fields: [providerId], references: [id], onDelete: SetNull)
}

model AIProviderCredential {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  kind         String        @default("openai-compatible")
  baseUrl      String        @default("https://api.openai.com/v1")
  encryptedKey String
  keyLastFour  String
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  settings     BotSettings[]

  @@index([workspaceId])
}

model KnowledgeSource {
  id        String           @id @default(cuid())
  botId     String
  name      String
  type      String
  content   String           @default("")
  url       String?
  status    String           @default("QUEUED")
  error     String?
  indexedAt DateTime?
  lockedAt  DateTime?
  createdAt DateTime         @default(now())
  bot       Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]

  @@unique([id, botId])
  @@index([botId, status])
}

model KnowledgeChunk {
  id             String                       @id @default(cuid())
  botId          String
  sourceId       String
  content        String
  embeddingModel String
  embedding      Unsupported("vector(1536)")?
  bot            Bot                          @relation(fields: [botId], references: [id], onDelete: Cascade)
  source         KnowledgeSource              @relation(fields: [sourceId, botId], references: [id, botId], onDelete: Cascade)

  @@index([botId])
}

model Conversation {
  id          String        @id @default(uuid())
  botId       String
  sessionHash String
  preview     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  bot         Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages    Message[]
  usage       UsageRecord[]

  @@index([botId, createdAt])
  @@index([botId, sessionHash])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  feedback       Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model UsageRecord {
  id             String        @id @default(cuid())
  botId          String
  conversationId String?
  model          String
  kind           String        @default("chat")
  inputTokens    Int
  outputTokens   Int
  estimated      Boolean       @default(false)
  cost           Float
  latencyMs      Int
  matched        Boolean       @default(true)
  preview        Boolean       @default(false)
  createdAt      DateTime      @default(now())
  bot            Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt])
}

model AllowedDomain {
  id     String @id @default(cuid())
  botId  String
  domain String
  bot    Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, domain])
}

model WidgetSettings {
  botId        String  @id
  displayName  String  @default("Website-Assistent")
  greeting     String  @default("Hallo! Wie kann ich dir heute helfen?")
  placeholder  String  @default("Stelle deine Frage …")
  primaryColor String  @default("#7360df")
  textColor    String  @default("#ffffff")
  avatarUrl    String  @default("")
  logoUrl      String  @default("")
  buttonIcon   String  @default("message")
  position     String  @default("right")
  radius       Int     @default(20)
  theme        String  @default("light")
  branding     Boolean @default(true)
  bot          Bot     @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  action      String
  targetId    String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
